# 블로그 소유자의 개인 홈페이지 (푸터 링크, JSON-LD의 author.url)
HOMEPAGE_URL=https://example.com

# 이 블로그의 공개 URL. canonical·og:url·sitemap·RSS의 절대 URL 기준이 된다
BLOG_URL=https://blog.example.com

# Directus의 blogs 컬렉션에서 이 블로그를 식별하는 slug.
# 모든 GraphQL 쿼리가 이 값으로 필터링된다
BLOG_SLUG=my-blog

# Directus 인스턴스 URL (끝에 슬래시 없이).
# /assets/<id> 이미지 변환 URL도 이 값을 기준으로 만들어진다
DIRECTUS_URL=https://cms.example.com

# RSS 피드의 author 이메일
EMAIL_ADDRESS=me@example.com

# 참고: 이 값들은 runtimeConfig.public 으로 들어가며 **빌드 시점에 번들에 구워진다**.
# 배포 플랫폼의 런타임 환경변수로 바꿔도 반영되지 않으므로, 빌드 환경에 설정해야 한다.
